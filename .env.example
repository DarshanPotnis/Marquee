# Copy to .env and fill in. .env is gitignored; never commit it.

# Ticketmaster Discovery API consumer key. Needed by ingest, not by migrate.
TM_API_KEY=

# Database URLs use Marquee's own names. The generic DATABASE_URL is never read, because other
# projects on the same machine export it.

# Postgres the pipeline writes to (Neon main branch in production).
MARQUEE_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Postgres for integration tests: a Neon dev branch, or the local container from
# `docker compose up -d`, which is:
#   postgresql://marquee:marquee@localhost:55432/marquee_test
# Integration tests skip cleanly when this is unset.
MARQUEE_TEST_DATABASE_URL=

# Days of raw API responses to keep, 1 to 14 (PLAN §8).
RAW_RETENTION_DAYS=3

# Minutes between scheduled runs. The dashboard derives its freshness colours from it.
SCHEDULE_INTERVAL_MINUTES=60
