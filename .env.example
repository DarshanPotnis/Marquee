# Copy to .env and fill in. .env is gitignored; never commit it.

# Ticketmaster Discovery API consumer key. Needed by ingest, not by migrate.
TM_API_KEY=

# Database URLs use Marquee's own names. The generic DATABASE_URL is never read, because other
# projects on the same machine export it. Both must use a direct host (no -pooler), because
# advisory locks need a direct connection, and the test URL must be a different database.

# Postgres the pipeline writes to. The default is the local container from
# `docker compose up -d --wait`. In production it's Neon's main branch (a direct host), e.g.
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
MARQUEE_DATABASE_URL=postgresql://marquee:marquee@localhost:55432/marquee

# Postgres for integration tests: the same local container's marquee_test database, or a Neon
# dev branch. Integration tests skip cleanly when this is unset.
MARQUEE_TEST_DATABASE_URL=postgresql://marquee:marquee@localhost:55432/marquee_test

# Days of raw API responses to keep, 1 to 14 (PLAN §8).
RAW_RETENTION_DAYS=3

# Minutes between scheduled runs. The dashboard derives its freshness colours from it.
SCHEDULE_INTERVAL_MINUTES=60
